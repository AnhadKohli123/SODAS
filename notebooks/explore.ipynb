   "source": [
    "import json\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "d = json.load(open('../data/coco_json/val.json'))\n",
    "s = np.array([np.sqrt(a['bbox'][2] * a['bbox'][3]) for a in d['annotations']])\n",
    "plt.hist(s, bins=60, range=(0, 150))\n",
    "print((s < 32).mean(), ((s >= 10) & (s <= 30)).mean())"
   ]
  }
